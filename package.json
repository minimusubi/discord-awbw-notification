{
	"name": "discord-awbw-notification",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "dotenvx run -f .env.dev --env NODE_OPTIONS=--enable-source-maps -- nuxt dev",
		"format": "prettier . --write",
		"postinstall": "nuxt prepare",
		"preview": "nuxt preview",
		"start": "node --env-file .env .output/server/index.mjs"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^2.2.0",
		"@nuxt/eslint": "^1.7.1",
		"@nuxtjs/color-mode": "^4.0.0",
		"discord.js": "^14.21.0",
		"eslint": "^10.0.2",
		"lowdb": "^7.0.1",
		"nuxt": "^4.4.8"
	},
	"devDependencies": {
		"@types/node": "^24.10.14",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"sass-embedded": "^1.89.2"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.27.7": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true
	}
}
